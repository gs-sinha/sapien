{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "service.yaml -- see PLAN.md section 6 and internal/domain/service.go (ServiceMetadata)",
  "title": "Service metadata file",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "owners": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "concepts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contracts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "environments": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/envHint" }
    },
    "accepted_warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptedWarning" }
    }
  },
  "$defs": {
    "envHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 }
      }
    },
    "acceptedWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "match": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
