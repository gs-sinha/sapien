{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "service.yaml -- see PLAN.md section 6 and internal/domain/service.go (ServiceMetadata)",
  "title": "Service metadata file",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "owners": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "concepts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "contracts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "environments": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/envHint" }
    },
    "accepted_warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptedWarning" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        { "oneOf": [{ "required": ["phrase"] }, { "required": ["phrases"] }] },
        { "oneOf": [{ "required": ["operation"] }, { "required": ["targets"] }] }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "phrase": { "type": "string", "minLength": 1 },
        "phrases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "operation": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/taskTarget" }
        },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskTest" }
        }
      }
    },
    "taskTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 }
      }
    },
    "taskTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "expect_any"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "expect_any": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "top_k": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "envHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 }
      }
    },
    "acceptedWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "match": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
