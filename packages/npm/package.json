{
  "name": "@gs-sinha/sapien",
  "version": "0.1.0",
  "description": "Local-first, agent-native API workspace engine (npm wrapper around the sapien binary, for MCP hosts that assume npx)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/gs-sinha/sapien",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gs-sinha/sapien.git",
    "directory": "packages/npm"
  },
  "bin": {
    "sapien": "bin/sapien.js"
  },
  "scripts": {
    "postinstall": "node bin/sapien.js --sapien-npm-postinstall || true"
  },
  "files": [
    "bin/sapien.js",
    "README.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
